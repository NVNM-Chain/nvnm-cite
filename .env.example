# Copy this file to .env and fill in the values yourself.
# .env is gitignored. Never paste these values into chat and never commit them.

# Network selection. Unset means testnet. Shipped profiles: testnet, devnet.
# Each profile names its own RPC override env and signing-key env.
#NVNM_NETWORK=testnet

# Testnet (default). Chain id, RPC, and explorer live in the profile.
NVNM_TESTNET_RPC=https://rpc.nvnm.testnet.nvnmchain.io

# Funded testnet private key: 64 hex characters. The 0x prefix is optional
# (MetaMask exports without it; both forms work). Throwaway only.
NVNM_TESTNET_KEY=

# Devnet. Opt-in via --network devnet or NVNM_NETWORK=devnet.
# Its key is never substituted for the testnet key.
#NVNM_DEVNET_RPC=https://rpc.nvnm.canary.mantrachain.dev
#NVNM_DEVNET_KEY=

# CourtListener API token (free account at https://www.courtlistener.com).
# Needed from Phase 2 onward for incremental updates and spot checks.
COURTLISTENER_TOKEN=
