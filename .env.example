# Copy this file to .env and fill in the values yourself.
# .env is gitignored. Never paste these values into chat and never commit them.

# Network selection. Unset means mainnet. Profiles: mainnet, testnet, devnet.
# Each profile names its own RPC override env and signing-key env.
# mainnet starts with no chain id and an empty court manifest. Set the four
# variables below when the chain is published. Citation checks stay
# NOT_COVERED until the manifest lists registries (NVNM_MANIFEST_PATH, or a
# rebuilt image that contains the generated file).
#NVNM_NETWORK=mainnet

# Testnet. Opt-in via --network testnet or NVNM_NETWORK=testnet.
# Chain id, RPC, and explorer live in the profile.
NVNM_TESTNET_RPC=https://rpc.nvnm.testnet.nvnmchain.io

# Funded testnet private key: 64 hex characters. The 0x prefix is optional
# (MetaMask exports without it; both forms work). Throwaway only.
NVNM_TESTNET_KEY=

# Devnet. Opt-in via --network devnet or NVNM_NETWORK=devnet.
# Its key is never substituted for the testnet key.
#NVNM_DEVNET_RPC=https://rpc.nvnm.canary.mantrachain.dev
#NVNM_DEVNET_KEY=

# Mainnet is the default. Leave these unset until the chain is published.
# The process still starts.
#NVNM_MAINNET_CHAIN_ID=
#NVNM_MAINNET_RPC=
#NVNM_MAINNET_EXPLORER=
#NVNM_MAINNET_NETWORK_NAME=
#NVNM_MAINNET_KEY=
# Read only while the packaged manifest lists no registries.
#NVNM_MANIFEST_PATH=

# CourtListener API token (free account at https://www.courtlistener.com).
# Needed from Phase 2 onward for incremental updates and spot checks.
COURTLISTENER_TOKEN=
